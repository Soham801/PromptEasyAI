# PromptEasyAI runtime configuration
PROMPTEASY_ENV=development
PROMPTEASY_PROVIDER=offline
PROMPTEASY_MODEL=offline-model
PROMPTEASY_RATE_LIMIT=60
PROMPTEASY_STORAGE_PATH=prompteasy.db

# Set this to require persistence endpoint authentication.
# Clients use: Authorization: Bearer <user-id>.<token>
PROMPTEASY_AUTH_TOKEN=

# Required only when PROMPTEASY_PROVIDER=groq
GROQ_API_KEY=
